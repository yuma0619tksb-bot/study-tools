  "k008": {
    "kind": "k_ratio",
    "level": 1,
    "params": {
      "expr": "n**3/3**n",
      "title": "比判定法(多項式÷指数)",
      "tool": "$n^3$ と $3^n$ の比較なので比をとると多項式部分は $1$ に近づき、指数部分の比 $\\dfrac{1}{3}$ だけが残る(ダランベールの判定法)。"
    },
    "family": 7,
    "unit": "収束判定",
    "variant_of": null
  },
  "k009": {
    "kind": "k_ratio",
    "level": 2,
    "params": {
      "expr": "factorial(n)**2/factorial(2*n)",
      "title": "比判定法(階乗)",
      "tool": "階乗を含む一般項は比をとると約分で多項式の比になる(ダランベールの判定法)。$(2n+2)!=(2n+2)(2n+1)(2n)!$ に注意する。"
    },
    "family": 8,
    "unit": "収束判定",
    "variant_of": null
  },
  "k010": {
    "kind": "k_ratio",
    "level": 2,
    "params": {
      "expr": "8**n*factorial(n)**2/factorial(2*n)",
      "title": "比判定法(階乗と指数)",
      "tool": "階乗と指数の積なので比をとる(ダランベール)。比の極限が $1$ より大きいか小さいかで判定する。"
    },
    "family": 9,
    "unit": "収束判定",
    "variant_of": null
  },
