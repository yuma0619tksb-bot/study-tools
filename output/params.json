  },
  "k012": {
    "kind": "k_root",
    "level": 1,
    "params": {
      "expr": "((4*n+1)/(5*n+2))**n",
      "base": "(4*n+1)/(5*n+2)",
      "title": "根判定法(n 乗の形)",
      "tool": "一般項が丸ごと $n$ 乗なので $n$ 乗根をとると括弧の中だけが残る(コーシーの根判定法)。"
    },
    "family": 11,
    "unit": "収束判定",
    "variant_of": null
  },
  "k013": {
    "kind": "k_root",
    "level": 2,
    "params": {
      "expr": "(n/(n+2))**(n**2)",
      "base": "(n/(n+2))**n",
      "title": "根判定法と e の極限",
      "tool": "指数が $n^2$ なので $n$ 乗根をとると $\\left(\\dfrac{n}{n+2}\\right)^n$ が残る。これは $\\left(1+\\dfrac{2}{n}\\right)^{-n}$ と見て $e$ の極限を使う。",
      "extra": "$\\left(\\dfrac{n}{n+2}\\right)^n=\\dfrac{1}{\\left(1+\\frac{2}{n}\\right)^n}$"
    },
    "family": 12,
    "unit": "収束判定",
    "variant_of": null
  },
  "k014": {
    "kind": "k_comp",
    "level": 1,
    "params": {
      "expr": "(n+2)/(n**3+1)",
      "p": "2",
      "title": "p 級数との極限比較",
      "tool": "分子は1次、分母は3次なので一般項は $\\dfrac{1}{n^2}$ と同じオーダー。$p$ 級数 $\\sum\\dfrac{1}{n^2}$ と極限比較する。"
    },
    "family": 13,
    "unit": "収束判定",
    "variant_of": null
  },
  "k015": {
    "kind": "k_comp",
    "level": 2,
    "params": {
      "expr": "1/sqrt(n**2+3*n)",
      "p": "1",
      "title": "極限比較で発散",
      "tool": "根号の中は2次式なので一般項は $\\dfrac{1}{n}$ と同じオーダー。調和級数($p=1$)と極限比較する。"
    },
    "family": 14,
    "unit": "収束判定",
    "variant_of": null
  },
  "k016": {
    "kind": "k_comp",
    "level": 2,
    "params": {
      "expr": "sqrt(n)/(n**2+2)",
      "p": "3/2",
      "title": "分数乗の p 級数と比較",
      "tool": "分子が $n^{1/2}$、分母が $n^2$ なので一般項は $\\dfrac{1}{n^{3/2}}$ のオーダー。$p=\\dfrac{3}{2}$ の $p$ 級数と極限比較する。"
    },
    "family": 15,
    "unit": "収束判定",
    "variant_of": null
  },
  "k017": {
    "kind": "k_comp",
    "level": 3,
    "params": {
      "expr": "1-cos(4/n)",
      "p": "2",
      "title": "テイラー展開と極限比較",
      "tool": "$n\\to\\infty$ で $\\dfrac{4}{n}\\to 0$ なので $1-\\cos\\theta\\approx\\dfrac{\\theta^2}{2}$ を使うと一般項は $\\dfrac{1}{n^2}$ のオーダーとわかる。これと極限比較する。",
      "extra": "$1-\\cos\\theta=\\dfrac{\\theta^2}{2}+O(\\theta^4)$ に $\\theta=\\dfrac{4}{n}$ を代入すると $1-\\cos\\dfrac{4}{n}\\approx\\dfrac{8}{n^2}$"
    },
    "family": 16,
    "unit": "収束判定",
    "variant_of": null
  },
  "k018": {
    "kind": "k_alt",
    "level": 1,
    "params": {
      "b": "1/n**(1/3)",
      "p": "1/3",
      "shift": true,
      "title": "交代 p 級数",
      "tool": "絶対値をとると $p=\\dfrac{1}{3}$ の $p$ 級数。絶対収束しないときはライプニッツの判定法で収束を確かめる。",
      "mono": "$\\sqrt[3]{n}$ は単調増加なので $\\dfrac{1}{\\sqrt[3]{n}}$ は単調減少"
    },
    "family": 17,
    "unit": "絶対収束・条件収束",
    "variant_of": null
  },
  "k019": {
    "kind": "k_alt",
    "level": 1,
    "params": {
      "b": "n/(n**3+2)",
      "p": "2",
      "title": "絶対収束の判定",
      "tool": "まず絶対値の級数を調べる。分子1次・分母3次で $\\dfrac{1}{n^2}$ のオーダーなので $p$ 級数と比較できる。",
      "mono": ""
    },
    "family": 18,
    "unit": "絶対収束・条件収束",
    "variant_of": null
  },
  "k020": {
    "kind": "k_alt",
    "level": 2,
    "params": {
      "b": "n/(n**2+3)",
      "p": "1",
      "title": "条件収束の判定",
      "tool": "絶対値は $\\dfrac{1}{n}$ のオーダーで発散するので絶対収束しない。そこでライプニッツの判定法($|a_n|$ が単調減少して $0$ に収束)を確かめる。",
      "mono": "$g(x)=\\dfrac{x}{x^2+3}$ は $g'(x)=\\dfrac{3-x^2}{(x^2+3)^2}<0$ $(x>\\sqrt{3})$ なので $n\\ge 2$ で単調減少"
    },
    "family": 19,
    "unit": "絶対収束・条件収束",
    "variant_of": null
  },
  "k021": {
    "kind": "k_alt",
    "level": 2,
    "params": {
      "b": "n/(5*n+1)",
      "title": "一般項が 0 に行かない交代級数",
      "tool": "交代級数でもまず一般項 $\\to 0$ を確認する。$0$ に収束しなければその時点で発散と決まる(ライプニッツは使えない)。"
    },
    "family": 20,
    "unit": "絶対収束・条件収束",
    "variant_of": null
  },
  "k022": {
    "kind": "k_alt",
    "level": 2,
    "params": {
      "b": "1/log(n+1)",
      "p": "0",
      "title": "対数を含む条件収束",
      "tool": "$\\log(n+1)<n+1$ を使うと絶対値の級数は調和級数より大きく発散する。一方 $\\dfrac{1}{\\log(n+1)}$ は単調減少して $0$ に収束するのでライプニッツが使える。",
      "abs_step": "$\\log(n+1)<n+1$ より $|a_n|=\\dfrac{1}{\\log(n+1)}>\\dfrac{1}{n+1}$。$\\displaystyle\\sum\\dfrac{1}{n+1}$ は発散するので比較判定法より $\\displaystyle\\sum|a_n|$ は発散",
      "mono": "$\\log(n+1)$ は単調増加なので $\\dfrac{1}{\\log(n+1)}$ は単調減少"
    },
    "family": 21,
    "unit": "絶対収束・条件収束",
    "variant_of": null
  },
